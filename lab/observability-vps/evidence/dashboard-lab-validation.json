      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 42},
      "targets": [
        {
          "expr": "{environment=\"lab\",level=\"error\",service!=\"\"} | json",
          "refId": "A",
          "queryType": "range"
        }
